#!/bin/sh
# Conventional Commits: https://www.conventionalcommits.org/
subject=$(head -n1 "$1")

# Let git's own messages through (merges, reverts, fixup/squash for autosquash)
case "$subject" in
  "Merge "*|"Revert \""*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

if ! printf '%s\n' "$subject" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .+'; then
  echo "Commit subject does not follow Conventional Commits: $subject"
  echo "Example: 'feat(api): add order endpoint' or 'feat!: drop v1 endpoint'"
  exit 1
fi
